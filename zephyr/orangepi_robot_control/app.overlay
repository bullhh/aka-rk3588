/ {
	chosen {
		zephyr,console = &vconsole;
		zephyr,shell-uart = &vconsole;
	};

	aliases {
		robot-uart = &uart6;
	};

	vconsole_clk: vconsole-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	vconsole: serial@9000000 {
		compatible = "arm,pl011";
		reg = <0x09000000 0x1000>;
		interrupts = <GIC_SPI 1 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
		interrupt-names = "irq_0";
		clocks = <&vconsole_clk>;
		current-speed = <115200>;
		status = "okay";
	};

	uart6: serial@feb90000 {
		compatible = "ns16550";
		reg = <0xfeb90000 0x100>;
		interrupts = <GIC_SPI 337 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
		reg-shift = <2>;
		/* U-Boot prepares the UART6 fractional parent at 16 MHz.  An
		 * integer divisor of one then gives the Feetech bus' exact 1 Mbps
		 * rate, matching the board's working Linux configuration.
		 */
		clock-frequency = <16000000>;
		current-speed = <1000000>;
		status = "okay";
	};
};

/* UART2 is the physical AxVisor host console.  The virtualized controller VM
 * must not instantiate its driver even though the base board DTS enables it.
 */
&uart2 {
	status = "disabled";
};

/* The fixed control workload needs no dynamic bulk RAM.  Keep Zephyr's own
 * page-frame ontology small; AxVisor still reserves a 128 MiB isolation slot.
 */
&sram0 {
	reg = <0x40000000 0x00080000>;
};
