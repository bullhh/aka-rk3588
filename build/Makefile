	$(MAKE) $(MAKESILENT) -f CMakeFiles/tennis.dir/build.make CMakeFiles/tennis.dir/tennis.cpp.i
.PHONY : tennis.cpp.i

tennis.s: tennis.cpp.s
.PHONY : tennis.s

# target to generate assembly for a file
tennis.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tennis.dir/build.make CMakeFiles/tennis.dir/tennis.cpp.s
.PHONY : tennis.cpp.s

test_cmds.o: test_cmds.cpp.o
.PHONY : test_cmds.o

# target to build an object file
test_cmds.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tennis.dir/build.make CMakeFiles/tennis.dir/test_cmds.cpp.o
.PHONY : test_cmds.cpp.o

test_cmds.i: test_cmds.cpp.i
.PHONY : test_cmds.i

# target to preprocess a source file
test_cmds.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tennis.dir/build.make CMakeFiles/tennis.dir/test_cmds.cpp.i
.PHONY : test_cmds.cpp.i

test_cmds.s: test_cmds.cpp.s
.PHONY : test_cmds.s

# target to generate assembly for a file
test_cmds.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tennis.dir/build.make CMakeFiles/tennis.dir/test_cmds.cpp.s
.PHONY : test_cmds.cpp.s

